{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // The combobox, search, listbox and group patterns need their ARIA roles written out, and the
    // 'status' ones are deliberate; this rule would ask for a different element for each of them.
    "jsx-a11y/prefer-tag-over-role": "off"
  }
}
